<!--
  Description:
    4-stem separation controls (Spleeter AI / DSP fallback), one section per
    stem. Compact variant for Tango's short deck rows; the labels, state
    colours and pressed styles live in style.qss (#StemStrip).
  Variables:
    group: the deck group to connect to
-->
<Template>
  <WidgetGroup>
    <ObjectName>StemStrip</ObjectName>
    <Layout>horizontal</Layout>
    <SizePolicy>me,min</SizePolicy>
    <MinimumSize>262,18</MinimumSize>
    <Children>

      <!-- ================= VOCALS ================= -->
      <PushButton>
        <Tooltip>Vocals: click to mute/unmute, right-click to solo</Tooltip>
        <ObjectName>StemVocalsButton</ObjectName>
        <Size>40f,18f</Size>
        <NumberStates>2</NumberStates>
        <RightClickIsPushButton>true</RightClickIsPushButton>
        <State><Number>0</Number><Text>VOC</Text><Alignment>center</Alignment></State>
        <State><Number>1</Number><Text>VOC</Text><Alignment>center</Alignment></State>
        <Connection>
          <ConfigKey><Variable name="group"/>,stem_vocals_enabled</ConfigKey>
          <ButtonState>LeftButton</ButtonState>
        </Connection>
        <Connection>
          <ConfigKey><Variable name="group"/>,stem_vocals_solo</ConfigKey>
          <ButtonState>RightButton</ButtonState>
        </Connection>
      </PushButton>
      <PushButton>
        <Tooltip>Solo vocals (hold)</Tooltip>
        <ObjectName>StemSoloVocButton</ObjectName>
        <Size>12f,18f</Size>
        <NumberStates>1</NumberStates>
        <State><Number>0</Number><Text>S</Text><Alignment>center</Alignment></State>
        <Connection><ConfigKey><Variable name="group"/>,stem_vocals_solo</ConfigKey></Connection>
      </PushButton>

      <WidgetGroup><Size>2f,0min</Size></WidgetGroup>

      <!-- ================= INSTRUMENTS ================= -->
      <PushButton>
        <Tooltip>Instruments: click to mute/unmute, right-click to solo</Tooltip>
        <ObjectName>StemInstButton</ObjectName>
        <Size>40f,18f</Size>
        <NumberStates>2</NumberStates>
        <RightClickIsPushButton>true</RightClickIsPushButton>
        <State><Number>0</Number><Text>INST</Text><Alignment>center</Alignment></State>
        <State><Number>1</Number><Text>INST</Text><Alignment>center</Alignment></State>
        <Connection>
          <ConfigKey><Variable name="group"/>,stem_inst_enabled</ConfigKey>
          <ButtonState>LeftButton</ButtonState>
        </Connection>
        <Connection>
          <ConfigKey><Variable name="group"/>,stem_inst_solo</ConfigKey>
          <ButtonState>RightButton</ButtonState>
        </Connection>
      </PushButton>
      <PushButton>
        <Tooltip>Solo instruments (hold)</Tooltip>
        <ObjectName>StemSoloInstButton</ObjectName>
        <Size>12f,18f</Size>
        <NumberStates>1</NumberStates>
        <State><Number>0</Number><Text>S</Text><Alignment>center</Alignment></State>
        <Connection><ConfigKey><Variable name="group"/>,stem_inst_solo</ConfigKey></Connection>
      </PushButton>

      <WidgetGroup><Size>2f,0min</Size></WidgetGroup>

      <!-- ================= BASS ================= -->
      <PushButton>
        <Tooltip>Bass: click to mute/unmute, right-click to solo</Tooltip>
        <ObjectName>StemBassButton</ObjectName>
        <Size>40f,18f</Size>
        <NumberStates>2</NumberStates>
        <RightClickIsPushButton>true</RightClickIsPushButton>
        <State><Number>0</Number><Text>BASS</Text><Alignment>center</Alignment></State>
        <State><Number>1</Number><Text>BASS</Text><Alignment>center</Alignment></State>
        <Connection>
          <ConfigKey><Variable name="group"/>,stem_bass_enabled</ConfigKey>
          <ButtonState>LeftButton</ButtonState>
        </Connection>
        <Connection>
          <ConfigKey><Variable name="group"/>,stem_bass_solo</ConfigKey>
          <ButtonState>RightButton</ButtonState>
        </Connection>
      </PushButton>
      <PushButton>
        <Tooltip>Solo bass (hold)</Tooltip>
        <ObjectName>StemSoloBassButton</ObjectName>
        <Size>12f,18f</Size>
        <NumberStates>1</NumberStates>
        <State><Number>0</Number><Text>S</Text><Alignment>center</Alignment></State>
        <Connection><ConfigKey><Variable name="group"/>,stem_bass_solo</ConfigKey></Connection>
      </PushButton>

      <WidgetGroup><Size>2f,0min</Size></WidgetGroup>

      <!-- ================= DRUMS ================= -->
      <PushButton>
        <Tooltip>Drums: click to mute/unmute, right-click to solo</Tooltip>
        <ObjectName>StemDrumsButton</ObjectName>
        <Size>40f,18f</Size>
        <NumberStates>2</NumberStates>
        <RightClickIsPushButton>true</RightClickIsPushButton>
        <State><Number>0</Number><Text>DRUM</Text><Alignment>center</Alignment></State>
        <State><Number>1</Number><Text>DRUM</Text><Alignment>center</Alignment></State>
        <Connection>
          <ConfigKey><Variable name="group"/>,stem_drums_enabled</ConfigKey>
          <ButtonState>LeftButton</ButtonState>
        </Connection>
        <Connection>
          <ConfigKey><Variable name="group"/>,stem_drums_solo</ConfigKey>
          <ButtonState>RightButton</ButtonState>
        </Connection>
      </PushButton>
      <PushButton>
        <Tooltip>Solo drums (hold)</Tooltip>
        <ObjectName>StemSoloDrmButton</ObjectName>
        <Size>12f,18f</Size>
        <NumberStates>1</NumberStates>
        <State><Number>0</Number><Text>S</Text><Alignment>center</Alignment></State>
        <Connection><ConfigKey><Variable name="group"/>,stem_drums_solo</ConfigKey></Connection>
      </PushButton>

      <WidgetGroup><Size>2f,0min</Size></WidgetGroup>

      <!-- ================= RESET + ENGINE MODE ================= -->
      <PushButton>
        <Tooltip>Reset: unmute all stems</Tooltip>
        <ObjectName>StemResetButton</ObjectName>
        <Size>26f,18f</Size>
        <NumberStates>1</NumberStates>
        <State><Number>0</Number><Text>ALL</Text><Alignment>center</Alignment></State>
        <Connection><ConfigKey><Variable name="group"/>,stem_reset</ConfigKey></Connection>
      </PushButton>
      <PushButton>
        <Tooltip>Stem engine: DSP (instant) vs Spleeter AI (4 stems)</Tooltip>
        <ObjectName>StemModeButton</ObjectName>
        <Size>26f,18f</Size>
        <NumberStates>2</NumberStates>
        <State><Number>0</Number><Text>DSP</Text><Alignment>center</Alignment></State>
        <State><Number>1</Number><Text>AI</Text><Alignment>center</Alignment></State>
        <Connection><ConfigKey><Variable name="group"/>,stems_source</ConfigKey></Connection>
      </PushButton>

    </Children>
  </WidgetGroup><!-- /StemStrip -->
</Template>
